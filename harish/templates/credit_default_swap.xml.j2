<FpML xmlns="http://www.fpml.org/FpML-5/confirmation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.fpml.org/FpML-5/confirmation fpml-doc.xsd"
      fpmlVersion="5-13">
  <trade>
    <tradeHeader>
      <partyTradeIdentifier>
        <partyReference href="Party1"/>
        <tradeId tradeIdScheme="http://example.com/trade-id">CDS-{{ id }}</tradeId>
      </partyTradeIdentifier>
      <tradeDate>{{ trade_date }}</tradeDate>
    </tradeHeader>
    <creditDefaultSwap>
      <generalTerms>
        <effectiveDate><unadjustedDate>{{ effective_date }}</unadjustedDate></effectiveDate>
        <scheduledTerminationDate><unadjustedDate>{{ maturity_date }}</unadjustedDate></scheduledTerminationDate>
        <buyerPartyReference href="Party1"/>
        <sellerPartyReference href="Party2"/>
      </generalTerms>
      <protectionTerms>
        <calculationAmount>
          <currency>USD</currency>
          <amount>{{ amount }}</amount>
        </calculationAmount>
      </protectionTerms>
    </creditDefaultSwap>
    <party id="Party1"><partyId>Client A</partyId></party>
    <party id="Party2"><partyId>Bank B</partyId></party>
  </trade>
</FpML>
