<requestConfirmation xmlns="http://www.fpml.org/FpML-5/confirmation"
                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     fpmlVersion="5-13"
                     xsi:schemaLocation="http://www.fpml.org/FpML-5/confirmation ../../fpml-main-5-13.xsd">
  <header>
    <messageId>FXTRADE-{{ trade.trade_id }}</messageId>
    <sentBy>{{ trade.party1.party_id }}</sentBy>
    <sendTo>{{ trade.party2.party_id }}</sendTo>
    <creationTimestamp>{{ trade.creation_timestamp }}</creationTimestamp>
  </header>
  <isCorrection>false</isCorrection>
  <correlationId>{{ trade.correlation_id }}</correlationId>
  <sequenceNumber>{{ trade.sequence_number }}</sequenceNumber>

  <trade>
    <tradeHeader>
      <partyTradeIdentifier>
        <partyReference href="party1"/>
        <tradeId>FXTRADE-{{ trade.trade_id }}</tradeId>
      </partyTradeIdentifier>
      <partyTradeIdentifier>
        <partyReference href="party2"/>
        <tradeId>FXTRADE-{{ trade.trade_id }}</tradeId>
      </partyTradeIdentifier>
      <tradeDate>{{ trade.trade_date }}</tradeDate>
    </tradeHeader>

    <fxSingleLeg>
      <exchangedCurrency1>
        <payerPartyReference href="party2"/>
        <receiverPartyReference href="party1"/>
        <paymentAmount>
          <currency>{{ trade.currency1 }}</currency>
          <amount>{{ trade.amount1 }}</amount>
        </paymentAmount>
      </exchangedCurrency1>
      <exchangedCurrency2>
        <payerPartyReference href="party1"/>
        <receiverPartyReference href="party2"/>
        <paymentAmount>
          <currency>{{ trade.currency2 }}</currency>
          <amount>{{ trade.amount2 }}</amount>
        </paymentAmount>
      </exchangedCurrency2>
      <valueDate>{{ trade.value_date }}</valueDate>
      <exchangeRate>
        <quotedCurrencyPair>
          <currency1>{{ trade.currency1 }}</currency1>
          <currency2>{{ trade.currency2 }}</currency2>
          <quoteBasis>Currency2PerCurrency1</quoteBasis>
        </quotedCurrencyPair>
        <rate>{{ trade.rate }}</rate>
        <spotRate>{{ trade.spot_rate }}</spotRate>
        <forwardPoints>{{ trade.forward_points }}</forwardPoints>
      </exchangeRate>
    </fxSingleLeg>
  </trade>

  <party id="party1">
    <partyId>{{ trade.party1.party_name }}</partyId>
  </party>
  <party id="party2">
    <partyId>{{ trade.party2.party_name }}</partyId>
  </party>
</requestConfirmation>
